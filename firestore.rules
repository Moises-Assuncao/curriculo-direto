rules_version = '2';

// Cada usuário só pode ler e escrever o próprio currículo.
// O documento fica em: curriculos/{uid}
service cloud.firestore {
  match /databases/{database}/documents {
    match /curriculos/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
